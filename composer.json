{
    "name": "claritymomentum/cm-order-customer-tagger",
    "description": "Automatically tag WooCommerce orders and customers using configurable rule-based conditions.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Clarity Momentum",
            "homepage": "https://claritymomentum.io"
        }
    ],
    "require": {
        "php": ">=8.1",
        "harperagency/rule-engine": "@dev"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "php-stubs/woocommerce-stubs": "^10.9",
        "php-stubs/wordpress-stubs": "^6.9",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10",
        "sebastian/phpcpd": "^2.0",
        "squizlabs/php_codesniffer": "^3.13",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "ClarityMomentum\\WCTagger\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClarityMomentum\\WCTagger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration tests/phpunit.xml"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../harper-rule-engine"
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
