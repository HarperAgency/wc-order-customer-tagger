{
    "name": "harperagency/wc-order-customer-tagger",
    "description": "Auto-tag WooCommerce orders and customers using configurable rule-based conditions.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "harperagency/rule-engine": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "psr-4": {
            "HarperAgency\\WCTagger\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HarperAgency\\WCTagger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration tests/phpunit.xml"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../harper-rule-engine"
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
