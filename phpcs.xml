<?xml version="1.0"?>
<ruleset name="CM Order &amp; Customer Tagger">
    <description>WordPress Coding Standards — PSR-4 filename exemption for autoloaded classes.</description>

    <rule ref="WordPress"/>

    <!--
        The includes/ directory uses PSR-4 autoloading (ClarityMomentum\WCTagger namespace).
        WordPress filename convention (class-foo-bar.php) is incompatible with PSR-4.
        These sniffs are suppressed for includes/ only.
    -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>includes/</exclude-pattern>
    </rule>

    <arg name="extensions" value="php"/>
    <exclude-pattern>vendor/</exclude-pattern>
    <exclude-pattern>tests/</exclude-pattern>
    <exclude-pattern>lib/</exclude-pattern>
</ruleset>
